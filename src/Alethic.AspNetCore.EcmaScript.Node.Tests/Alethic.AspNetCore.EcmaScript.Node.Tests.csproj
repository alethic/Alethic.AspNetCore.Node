<Project Sdk="MSTest.Sdk/4.3.3">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>

    <ItemGroup>
        <!-- MSTest.Sdk 3.10.4 referenced Microsoft.NET.Test.Sdk from its runner profile
             (Sdk/Runner/ClassicEngine.targets); 4.3.3 references it only under UseVSTest, so a build
             under 4 puts no VSTest testhost in the output. CI runs `dotnet test <dll>`, which is
             vstest.console, and every job aborted before a test ran, the testhost having failed to
             resolve Newtonsoft.Json. MSTest.TestAdapter still carries the VSTest bridge and still sets
             GenerateProgramFile=false under EnableMSTestRunner, so declaring the package restores what
             3.10.4 arranged, entry point included, and leaves the MSTest runner as it is. -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    </ItemGroup>

    <ItemGroup Label="One payload runs every system in the matrix, so every native runtime rides along.">
        <PackageReference Include="Microsoft.JavaScript.LibNode.win-x64" Version="20.1800.203" />
        <PackageReference Include="Microsoft.JavaScript.LibNode.linux-x64" Version="20.1800.203" />
        <PackageReference Include="Microsoft.JavaScript.LibNode.linux-arm64" Version="20.1800.203" />
        <PackageReference Include="Microsoft.JavaScript.LibNode.osx-x64" Version="20.1800.203" />
        <PackageReference Include="Microsoft.JavaScript.LibNode.osx-arm64" Version="20.1800.203" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alethic.AspNetCore.EcmaScript.Node\Alethic.AspNetCore.EcmaScript.Node.csproj" />
    </ItemGroup>

</Project>
