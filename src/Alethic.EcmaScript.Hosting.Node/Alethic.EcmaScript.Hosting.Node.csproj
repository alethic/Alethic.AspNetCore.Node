<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<Description>Runs JavaScript modules on a Node runtime embedded in the .NET process, through node-api-dotnet.</Description>
		<PackageTags>JavaScript, ECMAScript, hosting, Node</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.JavaScript.NodeApi" Version="0.9.26" />
		<PackageReference Include="System.IO.Pipelines" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Alethic.EcmaScript.Hosting\Alethic.EcmaScript.Hosting.csproj" />
	</ItemGroup>

</Project>
