<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<Description>This package contains the ASP.NET Core prerenderer.</Description>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Alethic.AspNetCore.EcmaScript.Spa.Abstractions\Alethic.AspNetCore.EcmaScript.Spa.Abstractions.csproj" />
		<ProjectReference Include="..\Alethic.AspNetCore.EcmaScript.Spa.Js\Alethic.AspNetCore.EcmaScript.Spa.Js.esproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<Target Name="IncludeJsResources" BeforeTargets="AssignTargetPaths">
		<ItemGroup>
			<EmbeddedResource Include="..\Alethic.AspNetCore.EcmaScript.Spa.Js\dist\prerenderer.js" />
		</ItemGroup>
	</Target>

</Project>
