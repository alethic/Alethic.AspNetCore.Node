		<PackageReference Include="Microsoft.JavaScript.LibNode.linux-x64" Version="20.1800.203" Condition=" $([MSBuild]::IsOSPlatform('Linux')) " />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Alethic.EcmaScript.Hosting.Node\Alethic.EcmaScript.Hosting.Node.csproj" />
