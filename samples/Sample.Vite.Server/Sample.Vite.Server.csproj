<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
		<TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
		<SpaRoot>..\Sample.Vite.Client\</SpaRoot>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
		<BuildServerSideRenderer>true</BuildServerSideRenderer>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Alethic.AspNetCore.EcmaScript.Spa\Alethic.AspNetCore.EcmaScript.Spa.csproj" />
		<ProjectReference Include="..\Sample.Vite.Client\Sample.Vite.Client.esproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
