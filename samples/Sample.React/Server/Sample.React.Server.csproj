<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup Label="Native runtime, per platform. The umbrella package pulls every RID at once.">
		<PackageReference Include="Microsoft.JavaScript.LibNode.win-x64" Version="20.1800.203" Condition=" $([MSBuild]::IsOSPlatform('Windows')) " />
		<PackageReference Include="Microsoft.JavaScript.LibNode.linux-x64" Version="20.1800.203" Condition=" $([MSBuild]::IsOSPlatform('Linux')) " />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\src\Alethic.AspNetCore.Node\Alethic.AspNetCore.Node.csproj" />
	</ItemGroup>

</Project>
